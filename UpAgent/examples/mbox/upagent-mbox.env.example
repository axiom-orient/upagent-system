# Strict mbox is the default. There is no automatic native fallback.
UPAGENT_EXECUTION_MODE=mbox-required
UPAGENT_WORKSPACE=/absolute/path/to/workspace
MBOX_BIN=/absolute/path/to/mbox

# Exact provider service names only. Omit for a fully offline run.
# Codex example: read the auth file itself, write only the state directory,
# and allow the exact chatgpt.com provider service.
# macOS mbox validates the initial TLS ClientHello SNI against CONNECT authority.
UPAGENT_PROVIDER_DOMAINS=chatgpt.com

# Only names the UpAgent provider adapter itself requires.
UPAGENT_ALLOW_ENV=OPENAI_API_KEY,HOME,PATH

# Optional additional existing file or directory paths, colon-separated.
# auth.json may be a file; state roots and tool data are usually directories.
UPAGENT_EXTRA_READ_PATHS=/absolute/path/to/auth.json
UPAGENT_EXTRA_WRITE_PATHS=/absolute/path/to/state

# Optional existing caller-owned 0700 temporary directory (macOS mbox).
UPAGENT_TMP_PATH=/absolute/path/to/tmp

# Keep Git metadata immutable unless the approved WorkUnit explicitly needs it.
UPAGENT_ALLOW_GIT_METADATA=0

# Optional supply-chain pin for the installed mbox binary.
UPAGENT_MBOX_SHA256=
